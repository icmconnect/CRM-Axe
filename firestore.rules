service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && request.auth.token.email.matches('(?i)^gustavomacedo\\.consultor@gmail\\.com$')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MASTER')
      );
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Casas de Axé
    match /casas_axe/{casaId} {
      allow read, write: if isAuthenticated();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin() || isOwner(userId);
      allow create: if isAuthenticated();
    }

    // Membros
    match /membros/{membroId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Financeiro
    match /financeiro/{docId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }

    // Security Logs
    match /security_logs/{logId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Eventos
    match /eventos/{eventoId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Itens Necessidade
    match /itens_necessidade/{itemId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Config (ACL/testers)
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Configuracoes
    match /configuracoes/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
